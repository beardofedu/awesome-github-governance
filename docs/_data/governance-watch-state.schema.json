{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub Governance Watch per-source review state",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "object",
      "required": ["changelog", "enterprise", "actions", "advanced-security"],
      "additionalProperties": false,
      "properties": {
        "changelog": { "$ref": "#/$defs/source" },
        "enterprise": { "$ref": "#/$defs/source" },
        "actions": { "$ref": "#/$defs/source" },
        "advanced-security": { "$ref": "#/$defs/source" }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["reviewed_through", "urls"],
      "additionalProperties": false,
      "properties": {
        "reviewed_through": {
          "type": ["string", "null"],
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
